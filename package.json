{
  "name": "ghg-accounting-backend",
  "version": "1.0.0",
  "description": "温室气体核算后端：活动数据与更正链、分版本因子库、GWP 集合、核算引擎、重述与 Shapley 差额分解、月度关账快照、追溯查询",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "build": "nest build && node scripts/copy-assets.js",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "test": "jest",
    "test:unit": "jest --testPathIgnorePatterns=.pg.spec.ts$",
    "test:pg": "jest --testPathPattern=.pg.spec.ts$ --runInBand",
    "test:cov": "jest --coverage",
    "lint": "tsc --noEmit",
    "seed": "ts-node seed/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.4",
    "@nestjs/core": "^10.4.4",
    "@nestjs/platform-express": "^10.4.4",
    "decimal.js": "^10.4.3",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.1.4",
    "@nestjs/testing": "^10.4.4",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.13",
    "@types/node": "^20.16.10",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2"
  }
}
